# Copy to .env and adjust. Never commit the real .env.

# Postgres (used by docker-compose and DATABASE_URL below)
POSTGRES_USER=ankur
POSTGRES_PASSWORD=ankur
POSTGRES_DB=ankur
# Host port published by docker-compose. Change this *and* DATABASE_URL if
# 5432 is already taken (another local Postgres, another compose project).
POSTGRES_PORT=5432

# Full DSN the API and seed script connect with. Port must match POSTGRES_PORT.
DATABASE_URL=postgresql://ankur:ankur@localhost:5432/ankur

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API. Add the deployed
# frontend origin here (e.g. https://ankur.example.com).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
