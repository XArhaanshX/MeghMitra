# Copy to .env and adjust. Never commit the real .env.

# Postgres (used by docker-compose and DATABASE_URL below)
POSTGRES_USER=ankur
POSTGRES_PASSWORD=ankur
POSTGRES_DB=ankur
POSTGRES_PORT=5432

# Full DSN the API and migration scripts connect with.
DATABASE_URL=postgresql://ankur:ankur@localhost:5432/ankur

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
