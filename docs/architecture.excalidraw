      "type": "text",
      "text": "PostgreSQL 16 + PostGIS\n\ndocuments            (unique sha256)\ndocument_pages       (text + method)\nextracted_rules      (fields + citation JSONB)\nrule_citations       (indexed provenance)\nextraction_runs\nreview_queue         (reserved worklist)\n\nCHECK  approved_rules_require_citation",
      "originalText": "PostgreSQL 16 + PostGIS\n\ndocuments            (unique sha256)\ndocument_pages       (text + method)\nextracted_rules      (fields + citation JSONB)\nrule_citations       (indexed provenance)\nextraction_runs\nreview_queue         (reserved worklist)\n\nCHECK  approved_rules_require_citation",
